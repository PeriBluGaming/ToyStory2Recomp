+#!/usr/bin/env python3
+import os
+import platform
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+import ctypes
+from unittest import mock
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
+sys.path.insert(0, os.path.join(ROOT, "tools"))
+
+import bios_module_build as bios  # noqa: E402
+import compile_overlays as co  # noqa: E402
+from windows_dll import windows_dll_compatibility  # noqa: E402
+
+
+def make_pe(path, imports=(), machine=0x8664):
+    data = bytearray(0x400)
+    data[:2] = b"MZ"
+    struct.pack_into("<I", data, 0x3C, 0x80)
+    data[0x80:0x84] = b"PE\0\0"
+    coff = 0x84
+    struct.pack_into("<HHIIIHH", data, coff, machine, 1, 0, 0, 0, 240, 0)
+    optional = coff + 20
+    struct.pack_into("<H", data, optional, 0x20B)
+    struct.pack_into("<I", data, optional + 60, 0x200)
+    struct.pack_into("<I", data, optional + 108, 16)
+    section_table = optional + 240
+    if imports:
+        struct.pack_into("<II", data, optional + 120, 0x1000,
+                         20 * (len(imports) + 1))
+    data[section_table:section_table + 8] = b".rdata\0\0"
+    struct.pack_into("<IIII", data, section_table + 8,
+                     0x200, 0x1000, 0x200, 0x200)
+    if imports:
+        for index, name in enumerate(imports):
+            descriptor = 0x200 + index * 20
+            name_rva = 0x1040 + index * 64
+            struct.pack_into("<I", data, descriptor + 12, name_rva)
+            name_offset = 0x200 + (name_rva - 0x1000)
+            encoded = name.encode("ascii") + b"\0"
+            data[name_offset:name_offset + len(encoded)] = encoded
+    with open(path, "wb") as output:
+        output.write(data)
+
+
+class WindowsDLLCompatibilityTests(unittest.TestCase):
+    def test_native_dll_is_accepted_and_legacy_posix_import_is_rejected(self):
+        with tempfile.TemporaryDirectory() as directory:
+            native = os.path.join(directory, "native.dll")
+            legacy = os.path.join(directory, "legacy.dll")
+            make_pe(native, ("KERNEL32.dll", "msvcrt.dll"))
+            make_pe(legacy, ("KERNEL32.dll", "msys-2.0.dll"))
+            self.assertEqual(windows_dll_compatibility(native, "win-x64"),
+                             (True, "ok"))
+            accepted, reason = windows_dll_compatibility(legacy, "win-x64")
+            self.assertFalse(accepted)
+            self.assertIn("msys-2.0.dll", reason)
+
+    def test_wrong_pe_architecture_is_rejected(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = os.path.join(directory, "x86.dll")
+            make_pe(path, ("KERNEL32.dll",), machine=0x014C)
+            accepted, reason = windows_dll_compatibility(path, "win-x64")
+            self.assertFalse(accepted)
+            self.assertIn("does not match", reason)
+
+    def test_legacy_cache_is_rejected_before_python_load(self):
+        old_os, old_arch = co._TARGET_OS, co._TARGET_ARCH
+        co.set_target_os("win")
+        co.set_target_arch("x64")
+        try:
+            with tempfile.TemporaryDirectory() as directory:
+                path = os.path.join(directory, "legacy.dll")
+                make_pe(path, ("KERNEL32.dll", "msys-2.0.dll"))
+                with mock.patch.object(co.os, "name", "nt"), \
+                     mock.patch.object(ctypes, "CDLL") as load:
+                    self.assertFalse(co._dll_runtime_exports_match(
+                        path, None, None, {0x80001000}))
+                    load.assert_not_called()
+        finally:
+            co.set_target_os(old_os)
+            co.set_target_arch(old_arch)
+
+    def test_runtime_c_preflight_accepts_native_and_rejects_posix_import(self):
+        compiler = shutil.which("cc") or shutil.which("clang")
+        if not compiler:
+            self.skipTest("no C compiler available for the runtime preflight test")
+        machine = {
+            "x64": 0x8664,
+            "arm64": 0xAA64,
+            "x86": 0x014C,
+            "x86_64": 0x8664,
+            "AMD64": 0x8664,
+            "aarch64": 0xAA64,
+            "i386": 0x014C,
+            "i686": 0x014C,
+        }.get(co.interpreter_arch())
+        if machine is None:
+            self.skipTest(f"unsupported test interpreter architecture {co.interpreter_arch()}")
+        source = """
+            #include "psx_windows_dll_compat.h"
+            #include <string.h>
+            int main(int argc, char **argv) {
+                char error[160] = {0};
+                int compatible = psx_windows_dll_compatible(argv[1], error, sizeof(error));
+                return compatible == (argc < 3) ? 0 : 1;
+            }
+        """
+        include = os.path.join(ROOT, "runtime", "include")
+        with tempfile.TemporaryDirectory() as directory:
+            executable = os.path.join(directory, "pecheck")
+            built = subprocess.run(
+                [compiler, "-std=c99", "-D_WIN32", "-I", include,
+                 "-x", "c", "-", "-o", executable],
+                input=source, text=True, capture_output=True)
+            self.assertEqual(built.returncode, 0, built.stderr)
+            native = os.path.join(directory, "native.dll")
+            legacy = os.path.join(directory, "legacy.dll")
+            wrong_arch = os.path.join(directory, "wrong-arch.dll")
+            make_pe(native, ("KERNEL32.dll", "msvcrt.dll"), machine)
+            make_pe(legacy, ("KERNEL32.dll", "msys-2.0.dll"), machine)
+            other_machine = 0x014C if machine != 0x014C else 0x8664
+            make_pe(wrong_arch, ("KERNEL32.dll",), other_machine)
+            self.assertEqual(subprocess.run([executable, native]).returncode, 0)
+            self.assertEqual(subprocess.run([executable, legacy, "reject"]).returncode, 0)
+            self.assertEqual(subprocess.run(
+                [executable, wrong_arch, "reject"]).returncode, 0)
+
+
+class WindowsCompilerSelectionTests(unittest.TestCase):
+    def setUp(self):
+        self.old_os, self.old_arch = co._TARGET_OS, co._TARGET_ARCH
+        co.set_target_os("win")
+        co.set_target_arch("x64")
+        co._WINDOWS_COMPILER_PROBES.clear()
+        self.directory = tempfile.TemporaryDirectory()
+        self.bad_dir = os.path.join(self.directory.name, "cygwin")
+        self.good_dir = os.path.join(self.directory.name, "mingw")
+        os.makedirs(self.bad_dir)
+        os.makedirs(self.good_dir)
+        self.bad = os.path.join(self.bad_dir, "gcc.exe")
+        self.good = os.path.join(self.good_dir, "gcc.exe")
+        self.wrapper = os.path.join(self.directory.name, "wrapper.exe")
+        for path in (self.bad, self.good, self.wrapper):
+            with open(path, "wb") as f:
+                f.write(b"test compiler placeholder")
+
+    def tearDown(self):
+        co.set_target_os(self.old_os)
+        co.set_target_arch(self.old_arch)
+        co._WINDOWS_COMPILER_PROBES.clear()
+        self.directory.cleanup()
+
+    def _fake_run(self, command, **kwargs):
+        compiler = command[0]
+        if command[-1] == "-dumpmachine":
+            target = ("x86_64-pc-cygwin" if compiler == self.bad
+                      else "x86_64-w64-mingw32")
+            return co.subprocess.CompletedProcess(command, 0, target, "")
+        output = command[command.index("-o") + 1]
+        imports = ("KERNEL32.dll", "msys-2.0.dll") if compiler == self.wrapper else (
+            "KERNEL32.dll", "msvcrt.dll")
+        make_pe(output, imports)
+        return co.subprocess.CompletedProcess(command, 0, "", "")
+
+    def test_skips_first_cygwin_gcc_and_selects_later_native_mingw(self):
+        path = os.pathsep.join((self.bad_dir, self.good_dir))
+        with mock.patch.dict(os.environ, {"PATH": path}, clear=False), \
+             mock.patch.object(co.subprocess, "run", side_effect=self._fake_run):
+            self.assertEqual(co.resolve_windows_gcc("gcc"), self.good)
+
+    def test_explicit_compatible_and_incompatible_compilers(self):
+        with mock.patch.object(co.subprocess, "run", side_effect=self._fake_run):
+            self.assertEqual(co.resolve_windows_gcc(self.good), self.good)
+            with self.assertRaisesRegex(RuntimeError, "configured Windows compiler"):
+                co.resolve_windows_gcc(self.bad)
+
+    def test_misleading_target_triple_is_rejected_by_emitted_pe(self):
+        with mock.patch.object(co.subprocess, "run", side_effect=self._fake_run):
+            with self.assertRaisesRegex(RuntimeError, "msys-2.0.dll"):
+                co.resolve_windows_gcc(self.wrapper)
+
+    def test_bios_builder_validates_emitted_dll(self):
+        output = os.path.join(self.directory.name, "bios.dll")
+
+        def compile_bad_dll(command, **kwargs):
+            make_pe(output, ("KERNEL32.dll", "cygwin1.dll"))
+            return co.subprocess.CompletedProcess(command, 0, "", "")
+
+        with mock.patch.object(co, "is_windows", return_value=True), \
+             mock.patch.object(co, "native_path", side_effect=lambda path: path), \
+             mock.patch.object(co, "resolve_windows_gcc", return_value=self.good) as resolve, \
+             mock.patch.object(co, "_toolchain_env", return_value=({}, self.good_dir)), \
+             mock.patch.object(bios.subprocess, "run", side_effect=compile_bad_dll):
+            result = bios.compile_module(
+                [os.path.join(self.directory.name, "unit.c")], output, [],
+                "SCPH1001", 0, "gcc", "gcc", "tcc")
+        self.assertFalse(result)
+        resolve.assert_called_once_with("gcc")
+
+
+class ToolchainEntrypointImportTests(unittest.TestCase):
+    def test_script_imports_siblings_without_script_dir_on_sys_path(self):
+        # Set PSX_EMBEDDED_PYTHON to the bundled overlay_toolchain\python\python.exe
+        # to run this against the real embedded interpreter (isolated via ._pth).
+        python = os.environ.get("PSX_EMBEDDED_PYTHON") or sys.executable
+        with tempfile.TemporaryDirectory() as staged, \
+             tempfile.TemporaryDirectory() as cwd:
+            for name in ("compile_overlays.py", "windows_dll.py"):
+                shutil.copy2(os.path.join(ROOT, "tools", name), staged)
+            # -I (like a ._pth embedded Python) leaves the script dir off sys.path.
+            result = subprocess.run(
+                [python, "-I", os.path.join(staged, "compile_overlays.py"), "--help"],
+                cwd=cwd, capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertNotIn("ModuleNotFoundError", result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
