diff --git a/runtime/include/psx_windows_dll_compat.h b/runtime/include/psx_windows_dll_compat.h
new file mode 100644
index 00000000..ce0bbccd
--- /dev/null
+++ b/runtime/include/psx_windows_dll_compat.h
@@ -0,0 +1,182 @@
+#ifndef PSX_WINDOWS_DLL_COMPAT_H
+#define PSX_WINDOWS_DLL_COMPAT_H
+
+#ifdef _WIN32
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int psx_pe_read_u16(const unsigned char *data, size_t size,
+                           size_t offset, uint16_t *value) {
+    if (offset > size || size - offset < 2) return 0;
+    *value = (uint16_t)data[offset] | (uint16_t)data[offset + 1] << 8;
+    return 1;
+}
+
+static int psx_pe_read_u32(const unsigned char *data, size_t size,
+                           size_t offset, uint32_t *value) {
+    if (offset > size || size - offset < 4) return 0;
+    *value = (uint32_t)data[offset] |
+             (uint32_t)data[offset + 1] << 8 |
+             (uint32_t)data[offset + 2] << 16 |
+             (uint32_t)data[offset + 3] << 24;
+    return 1;
+}
+
+static int psx_pe_rva_offset(const unsigned char *data, size_t size,
+                             size_t section_table, uint16_t section_count,
+                             uint32_t headers_size, uint32_t rva,
+                             size_t *offset) {
+    if (rva < headers_size && rva < size) {
+        *offset = (size_t)rva;
+        return 1;
+    }
+    for (uint16_t i = 0; i < section_count; ++i) {
+        size_t row = section_table + (size_t)i * 40;
+        uint32_t virtual_size, virtual_address, raw_size, raw_offset;
+        if (!psx_pe_read_u32(data, size, row + 8, &virtual_size) ||
+            !psx_pe_read_u32(data, size, row + 12, &virtual_address) ||
+            !psx_pe_read_u32(data, size, row + 16, &raw_size) ||
+            !psx_pe_read_u32(data, size, row + 20, &raw_offset))
+            return 0;
+        uint32_t span = virtual_size > raw_size ? virtual_size : raw_size;
+        if (rva >= virtual_address && rva - virtual_address < span) {
+            uint32_t delta = rva - virtual_address;
+            if (delta >= raw_size || raw_offset > size ||
+                delta > size - raw_offset)
+                return 0;
+            *offset = (size_t)raw_offset + delta;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int psx_ascii_name_equal(const unsigned char *name, const char *expected) {
+    while (*expected) {
+        unsigned char a = *name++;
+        unsigned char b = (unsigned char)*expected++;
+        if (a >= 'A' && a <= 'Z') a = (unsigned char)(a + ('a' - 'A'));
+        if (b >= 'A' && b <= 'Z') b = (unsigned char)(b + ('a' - 'A'));
+        if (a != b) return 0;
+    }
+    return *name == '\0';
+}
+
+static int psx_windows_dll_compatible(const char *path, char *error,
+                                      size_t error_cap) {
+    FILE *file = NULL;
+    unsigned char *data = NULL;
+    long file_size;
+    uint32_t pe_offset, headers_size;
+    uint16_t machine, section_count, optional_size, magic;
+    uint32_t directory_count, import_rva, import_size;
+    size_t optional, section_table, import_offset;
+    int ok = 0;
+#if defined(_M_ARM64) || defined(__aarch64__)
+    const uint16_t expected_machine = 0xAA64;
+#elif defined(_M_IX86) || defined(__i386__)
+    const uint16_t expected_machine = 0x014C;
+#else
+    const uint16_t expected_machine = 0x8664;
+#endif
+
+#define PSX_PE_FAIL(message) do { \
+    if (error && error_cap) snprintf(error, error_cap, "%s", (message)); \
+    goto done; \
+} while (0)
+
+    file = fopen(path, "rb");
+    if (!file || fseek(file, 0, SEEK_END) != 0 ||
+        (file_size = ftell(file)) < 64 || fseek(file, 0, SEEK_SET) != 0)
+        PSX_PE_FAIL("cannot read PE file");
+    data = (unsigned char *)malloc((size_t)file_size);
+    if (!data || fread(data, 1, (size_t)file_size, file) != (size_t)file_size)
+        PSX_PE_FAIL("cannot read PE contents");
+    if (data[0] != 'M' || data[1] != 'Z' ||
+        !psx_pe_read_u32(data, (size_t)file_size, 0x3C, &pe_offset) ||
+        pe_offset > (uint32_t)file_size ||
+        (size_t)file_size - pe_offset < 24 ||
+        memcmp(data + pe_offset, "PE\0\0", 4) != 0)
+        PSX_PE_FAIL("invalid PE signature");
+    if (!psx_pe_read_u16(data, (size_t)file_size, pe_offset + 4, &machine) ||
+        !psx_pe_read_u16(data, (size_t)file_size, pe_offset + 6, &section_count) ||
+        !psx_pe_read_u16(data, (size_t)file_size, pe_offset + 20, &optional_size))
+        PSX_PE_FAIL("truncated PE COFF header");
+    if (machine != expected_machine) PSX_PE_FAIL("PE machine does not match runtime");
+    optional = (size_t)pe_offset + 24;
+    if (optional > (size_t)file_size ||
+        optional_size > (size_t)file_size - optional ||
+        !psx_pe_read_u16(data, (size_t)file_size, optional, &magic))
+        PSX_PE_FAIL("truncated PE optional header");
+    if (magic == 0x10B) {
+        if (optional_size < 96) PSX_PE_FAIL("truncated PE32 optional header");
+        if (!psx_pe_read_u32(data, (size_t)file_size, optional + 92,
+                             &directory_count))
+            PSX_PE_FAIL("truncated PE32 directories");
+        import_rva = import_size = 0;
+        if (directory_count > 1 && optional_size < 112)
+            PSX_PE_FAIL("truncated PE32 import directory");
+        if (directory_count > 1 &&
+            (!psx_pe_read_u32(data, (size_t)file_size, optional + 104,
+                              &import_rva) ||
+             !psx_pe_read_u32(data, (size_t)file_size, optional + 108,
+                              &import_size)))
+            PSX_PE_FAIL("truncated PE32 import directory");
+    } else if (magic == 0x20B) {
+        if (optional_size < 112) PSX_PE_FAIL("truncated PE32+ optional header");
+        if (!psx_pe_read_u32(data, (size_t)file_size, optional + 108,
+                             &directory_count))
+            PSX_PE_FAIL("truncated PE32+ directories");
+        import_rva = import_size = 0;
+        if (directory_count > 1 && optional_size < 128)
+            PSX_PE_FAIL("truncated PE32+ import directory");
+        if (directory_count > 1 &&
+            (!psx_pe_read_u32(data, (size_t)file_size, optional + 120,
+                              &import_rva) ||
+             !psx_pe_read_u32(data, (size_t)file_size, optional + 124,
+                              &import_size)))
+            PSX_PE_FAIL("truncated PE32+ import directory");
+    } else {
+        PSX_PE_FAIL("unsupported PE optional-header format");
+    }
+    if (!import_rva || !import_size) { ok = 1; goto done; }
+    if (!psx_pe_read_u32(data, (size_t)file_size, optional + 60, &headers_size))
+        PSX_PE_FAIL("truncated PE headers");
+    section_table = optional + optional_size;
+    if (section_table > (size_t)file_size ||
+        (size_t)section_count > ((size_t)file_size - section_table) / 40 ||
+        !psx_pe_rva_offset(data, (size_t)file_size, section_table,
+                           section_count, headers_size, import_rva,
+                           &import_offset))
+        PSX_PE_FAIL("invalid PE import table");
+    for (size_t cursor = import_offset, remaining = import_size;
+         remaining >= 20 && cursor <= (size_t)file_size &&
+         (size_t)file_size - cursor >= 20; cursor += 20, remaining -= 20) {
+        uint32_t name_rva;
+        size_t name_offset;
+        if (!psx_pe_read_u32(data, (size_t)file_size, cursor + 12, &name_rva))
+            PSX_PE_FAIL("truncated PE import descriptor");
+        if (!name_rva) { ok = 1; goto done; }
+        if (!psx_pe_rva_offset(data, (size_t)file_size, section_table,
+                               section_count, headers_size, name_rva,
+                               &name_offset) ||
+            !memchr(data + name_offset, '\0', (size_t)file_size - name_offset))
+            PSX_PE_FAIL("invalid PE import name");
+        if (psx_ascii_name_equal(data + name_offset, "msys-2.0.dll") ||
+            psx_ascii_name_equal(data + name_offset, "cygwin1.dll"))
+            PSX_PE_FAIL("disallowed MSYS/Cygwin runtime import");
+    }
+    PSX_PE_FAIL("unterminated PE import table");
+
+done:
+    if (file) fclose(file);
+    free(data);
+#undef PSX_PE_FAIL
+    return ok;
+}
+
+#endif /* _WIN32 */
+#endif /* PSX_WINDOWS_DLL_COMPAT_H */
