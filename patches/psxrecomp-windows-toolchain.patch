+"""Small PE validation helpers for runtime-generated Windows modules."""
+
+from __future__ import annotations
+
+import os
+import struct
+
+
+_MACHINE_BY_ARCH = {
+    "x86": 0x014C,
+    "x64": 0x8664,
+    "arm64": 0xAA64,
+}
+_POSIX_RUNTIMES = {"msys-2.0.dll", "cygwin1.dll"}
+
+
+class PEFormatError(ValueError):
+    pass
+
+
+def _u16(data: bytes, offset: int) -> int:
+    if offset < 0 or offset + 2 > len(data):
+        raise PEFormatError("truncated PE header")
+    return struct.unpack_from("<H", data, offset)[0]
+
+
+def _u32(data: bytes, offset: int) -> int:
+    if offset < 0 or offset + 4 > len(data):
+        raise PEFormatError("truncated PE header")
+    return struct.unpack_from("<I", data, offset)[0]
+
+
+def pe_machine_and_imports(path: str) -> tuple[int, set[str]]:
+    with open(path, "rb") as source:
+        data = source.read()
+    if len(data) < 64 or data[:2] != b"MZ":
+        raise PEFormatError("missing DOS/PE signature")
+
+    pe_offset = _u32(data, 0x3C)
+    if pe_offset + 24 > len(data) or data[pe_offset:pe_offset + 4] != b"PE\0\0":
+        raise PEFormatError("invalid PE signature")
+    coff = pe_offset + 4
+    machine = _u16(data, coff)
+    sections = _u16(data, coff + 2)
+    optional_size = _u16(data, coff + 16)
+    optional = coff + 20
+    if optional + optional_size > len(data):
+        raise PEFormatError("truncated optional header")
+
+    magic = _u16(data, optional)
+    if magic == 0x10B:
+        directory_offset, count_offset = 96, 92
+    elif magic == 0x20B:
+        directory_offset, count_offset = 112, 108
+    else:
+        raise PEFormatError("unsupported PE optional-header format")
+    if optional_size < directory_offset or _u32(data, optional + count_offset) <= 1:
+        return machine, set()
+    if optional_size < directory_offset + 16:
+        raise PEFormatError("truncated import data directory")
+    import_rva = _u32(data, optional + directory_offset + 8)
+    import_size = _u32(data, optional + directory_offset + 12)
+    if not import_rva or not import_size:
+        return machine, set()
+
+    section_offset = optional + optional_size
+    if section_offset + sections * 40 > len(data):
+        raise PEFormatError("truncated section table")
+    section_rows = []
+    for index in range(sections):
+        row = section_offset + index * 40
+        virtual_size = _u32(data, row + 8)
+        virtual_address = _u32(data, row + 12)
+        raw_size = _u32(data, row + 16)
+        raw_offset = _u32(data, row + 20)
+        section_rows.append((virtual_address, max(virtual_size, raw_size),
+                             raw_size, raw_offset))
+    size_of_headers = _u32(data, optional + 60)
+
+    def rva_offset(rva: int) -> int:
+        if rva < size_of_headers:
+            if rva >= len(data):
+                raise PEFormatError("header RVA is outside the file")
+            return rva
+        for va, span, raw_size, raw_offset in section_rows:
+            if va <= rva < va + span:
+                delta = rva - va
+                if delta >= raw_size or raw_offset + delta >= len(data):
+                    break
+                return raw_offset + delta
+        raise PEFormatError("import RVA is outside file-backed PE sections")
+
+    imports = set()
+    descriptor = rva_offset(import_rva)
+    descriptor_limit = min(len(data), descriptor + import_size)
+    terminated = False
+    while descriptor + 20 <= descriptor_limit:
+        name_rva = _u32(data, descriptor + 12)
+        if name_rva == 0:
+            terminated = True
+            break
+        name_offset = rva_offset(name_rva)
+        end = data.find(b"\0", name_offset, min(len(data), name_offset + 4096))
+        if end < 0:
+            raise PEFormatError("unterminated import name")
+        try:
+            imports.add(data[name_offset:end].decode("ascii").lower())
+        except UnicodeDecodeError as exc:
+            raise PEFormatError("non-ASCII import name") from exc
+        descriptor += 20
+    if not terminated:
+        raise PEFormatError("unterminated PE import table")
+    return machine, imports
+
+
+def windows_dll_compatibility(path: str, arch_abi: str) -> tuple[bool, str]:
+    """Check a generated/cached DLL before any native loader sees it."""
+    try:
+        _os_tag, arch = arch_abi.split("-", 1)
+    except ValueError:
+        return False, f"invalid runtime architecture tag {arch_abi!r}"
+    expected_machine = _MACHINE_BY_ARCH.get(arch)
+    if not arch_abi.startswith("win-") or expected_machine is None:
+        return False, f"unsupported Windows runtime architecture {arch_abi!r}"
+    try:
+        machine, imports = pe_machine_and_imports(path)
+    except (OSError, PEFormatError) as exc:
+        return False, str(exc)
+    if machine != expected_machine:
+        return False, (f"PE machine 0x{machine:04x} does not match "
+                       f"{arch_abi}")
+    bad_imports = sorted(imports & _POSIX_RUNTIMES)
+    if bad_imports:
+        return False, "disallowed POSIX runtime import(s): " + ", ".join(bad_imports)
+    return True, "ok"
